# --- Mailbox (Gmail) -------------------------------------------------------
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Gmail > Settings > See all settings > Forwarding and POP/IMAP > Enable IMAP.
# Copy this file to .env and fill in. NEVER commit .env.
MAIL_ADDRESS=your.bank.inbox@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional (defaults shown)
# IMAP_HOST=imap.gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Check the mailbox in the background every N seconds (0 = off, use POST /emails/mailbox/poll)
# MAIL_POLL_SECONDS=0
# What the reply tells a customer whose request cannot be completed by email (e.g. an address change).
# Put the client's real channel here. Default: "Please contact customer support for assistance."
# SUPPORT_CONTACT_TEXT=Please log in to net banking or call 1800-XXX-XXXX to update your details.

# Model call limits (defaults shown): give up after N seconds, context window, how long the model stays loaded,
# and how much of an email the model reads (numbers and dates are still read from the full text).
# OLLAMA_TIMEOUT_SECONDS=120
# OLLAMA_NUM_CTX=4096
# OLLAMA_KEEP_ALIVE=30m
# MAX_EMAIL_CHARS=6000

# Ollama model (default llama3.2:3b). Docker pulls it automatically; locally run: ollama pull <model>
# OLLAMA_MODEL=llama3.2:3b

# Shared secret for the reviewer console and the /emails API (approving sends real email).
# Leave empty only on a private development machine. Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
# REVIEWER_TOKEN=

# --- Tracing (optional, off unless an endpoint is set) ----------------------------------------------
# Every email becomes one trace: the model call (tokens, load/generate time), each tool call, the draft and the
# reviewer's decision. Bundled viewer: `docker compose --profile tracing up -d`, then open http://localhost:6006
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
# Other backends use the same two standard variables, e.g. Langfuse or LangSmith (see the README):
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public:secret>
# Also record the prompt and the model's answer (customer text; numbers are masked). Development only.
# TRACE_CONTENT=false
# TRACE_PROJECT=ai-email-agent

# Only look at unread mail from the last N days (keeps the agent away from an old backlog)
# MAIL_MAX_AGE_DAYS=2
# Only fetch mail from these senders (comma-separated). Strongly advised when testing on a real inbox.
# MAIL_ONLY_FROM=customer@gmail.com
# Only answer senders whose domain Gmail verified with DKIM/SPF. Leave on.
# REQUIRE_SENDER_AUTH=true
